# Flask
SESSION_SECRET=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-different-long-random-value

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. Never expose this key in HTML/JavaScript.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase > Connect > Session pooler / direct Postgres connection string
# psycopg supports postgresql://... ; URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Optional SMTP notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
MAIL_FROM=
